import React from "react";
import {
  AbsoluteFill,
  Audio,
  Easing,
  Img,
  interpolate,
  Sequence,
  staticFile,
  useCurrentFrame,
  useVideoConfig,
} from "remotion";
import timelineJson from "../public/character-performer/kids/dialogue/timeline.json";
import d0c from "../public/character-performer/kids/dialogue/d0_cues.json";
import d1c from "../public/character-performer/kids/dialogue/d1_cues.json";
import d2c from "../public/character-performer/kids/dialogue/d2_cues.json";
import d3c from "../public/character-performer/kids/dialogue/d3_cues.json";
import d4c from "../public/character-performer/kids/dialogue/d4_cues.json";
import d5c from "../public/character-performer/kids/dialogue/d5_cues.json";
import d6c from "../public/character-performer/kids/dialogue/d6_cues.json";
import d7c from "../public/character-performer/kids/dialogue/d7_cues.json";

// ---------------------------------------------------------------------------
// KidsStoryMultiScene — multi-scene storytelling upgrade of KidsRabbitDuet:
// 5 backgrounds with 0.5s crossfades + continuous Ken Burns camera, dynamic
// staging (characters slide inside transition windows; turtle walks left
// through i5), title card centered, S5 celebration (turtle proud bounce,
// rabbit clap, deterministic confetti).
// Rabbit + turtle rigs, viseme table, mouthAtCues, blink/hop/sleep/wake/proud
// envelopes are copied verbatim from KidsRabbitDuet.tsx (clip ids re-prefixed
// `ms-`). Pure function of frame: no Math.random / Date / CSS animation.
//
// Cue offset math: d{i}_cues.json t=0 is the START of that line's wav, NOT the
// shared timeline. Lookup time = t - line.start (see mouthAtCues call sites).
// ---------------------------------------------------------------------------

type MouthCue = { start: number; end: number; value: string };
type Line = { i: number; who: "rabbit" | "turtle"; text: string; start: number; dur: number };

const LINES = (timelineJson as any).lines as Line[];
const LINE_CUES: MouthCue[][] = [d0c, d1c, d2c, d3c, d4c, d5c, d6c, d7c].map(
  (c) => (c as any).mouthCues as MouthCue[]
);

const OUT = "#3a2e2a"; // warm dark brown outline (same as rabbit)
const EASE_OUT_BACK = Easing.bezier(0.34, 1.56, 0.64, 1);
const EOC = Easing.out(Easing.cubic);
const EIC = Easing.in(Easing.cubic);
const EIO = Easing.inOut(Easing.cubic);

const lerp = (a: number, b: number, p: number) => a + (b - a) * p;
const clamp01 = (v: number) => Math.min(1, Math.max(0, v));

// pivot-wrap transform helper (from KidsRabbitCode)
const piv = (cx: number, cy: number, deg: number, sx = 1, sy = 1) =>
  `translate(${cx} ${cy}) rotate(${deg}) scale(${sx} ${sy}) translate(${-cx} ${-cy})`;

// ---- viseme targets (QC-passed table from KidsRabbitCode / REPORT_CODE.md) ----
const VISEMES: Record<string, { rx: number; ry: number }> = {
  X: { rx: 0, ry: 0 },
  B: { rx: 9, ry: 3 },
  C: { rx: 13, ry: 7 },
  D: { rx: 20, ry: 15 },
  E: { rx: 26, ry: 9 },
  F: { rx: 10, ry: 6 },
  G: { rx: 8, ry: 8 },
  H: { rx: 28, ry: 22 },
  A: { rx: 30, ry: 26 },
};

// Generalized version of KidsRabbitCode.mouthAt (same interpolation contract)
const mouthAtCues = (cues: MouthCue[], tt: number): { rx: number; ry: number } => {
  if (!cues.length || tt < cues[0].start) return VISEMES.X;
  let i = -1;
  for (let j = cues.length - 1; j >= 0; j--) {
    if (cues[j].start <= tt) {
      i = j;
      break;
    }
  }
  if (i < 0) return VISEMES.X;
  const lastCue = cues[cues.length - 1];
  if (tt >= lastCue.end) {
    const last = VISEMES[lastCue.value] ?? VISEMES.X;
    const p = EOC(Math.min(1, (tt - lastCue.end) / 0.07));
    return { rx: lerp(last.rx, 0, p), ry: lerp(last.ry, 0, p) };
  }
  const cur = VISEMES[cues[i].value] ?? VISEMES.X;
  const since = tt - cues[i].start;
  if (since < 0.07 && i > 0) {
    const prev = VISEMES[cues[i - 1].value] ?? VISEMES.X;
    const p = EOC(clamp01(since / 0.07));
    return { rx: lerp(prev.rx, cur.rx, p), ry: lerp(prev.ry, cur.ry, p) };
  }
  return cur;
};

const activeLine = (t: number): Line | null =>
  LINES.find((l) => t >= l.start - 0.05 && t < l.start + l.dur + 0.05) ?? null;

// smooth on/off envelope around a line (nod amplitude, head extension...)
const envAt = (tt: number, a0: number, a1: number, b0: number, b1: number): number =>
  interpolate(tt, [a0, a1], [0, 1], {
    easing: EOC,
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  }) *
  interpolate(tt, [b0, b1], [1, 0], {
    easing: EOC,
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });

// ---- blink: close 80ms easeInCubic, open 120ms easeOutCubic ----
const blinkFrom = (starts: number[], tt: number): number => {
  let b = 0;
  for (const s of starts) {
    const dt = tt - s;
    if (dt < 0 || dt >= 0.2) continue;
    const v = dt < 0.08 ? EIC(dt / 0.08) : 1 - EOC(clamp01((dt - 0.08) / 0.12));
    b = Math.max(b, v);
  }
  return b;
};

// deterministic schedules (no randomness) — remapped to v2 timeline (39.6s)
const RABBIT_BLINKS = [1.4, 6.1, 6.3, 9.8, 14.3, 14.6, 17.6, 19.4, 21.5, 21.7, 25.4, 29.8, 31.4, 35.3, 35.5, 37.6];
const TURTLE_BLINKS = [1.6, 5.6, 9.6, 13.6, 17.6, 21.6, 25.6, 29.6, 33.6, 37.2]; // slower: ~4s cycle

// rabbit hops (v2 anchors): i0 tail + i2 tail; S5 rabbit claps instead
const HOPS: { s: number; h: number }[] = [
  { s: 3.75, h: 34 },
  { s: 13.55, h: 34 },
];

// hopState copied from KidsRabbitCode (same squash-stretch contract)
const hopState = (tt: number): { dy: number; sx: number; sy: number; arm: number } => {
  let dy = 0;
  let sx = 1;
  let sy = 1;
  let arm = 0;
  for (const { s, h } of HOPS) {
    const p = tt - s;
    if (p < 0 || p > 0.45) continue;
    dy += interpolate(p, [0.09, 0.2, 0.31], [0, -h, 0], {
      easing: [EOC, EIC],
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });
    sx *= interpolate(p, [0, 0.09, 0.15, 0.31, 0.45], [1, 1.07, 0.94, 1.05, 1], {
      easing: [EIC, EOC, EIC, EASE_OUT_BACK],
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });
    sy *= interpolate(p, [0, 0.09, 0.15, 0.31, 0.45], [1, 0.93, 1.08, 0.95, 1], {
      easing: [EIC, EOC, EIC, EASE_OUT_BACK],
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });
    arm = Math.max(
      arm,
      interpolate(p, [0.09, 0.16, 0.24, 0.36], [0, 14, 14, 0], {
        easing: [EOC, Easing.linear, EIC],
        extrapolateLeft: "clamp",
        extrapolateRight: "clamp",
      })
    );
  }
  return { dy, sx, sy, arm };
};

// ---- rabbit geometry (kawaii v3: chibi huge head ~56% height, chubby body) ----
const FEET_Y = 856;
const BODY = { cx: 540, cy: 775, rx: 115, ry: 98 }; // short chubby
const HEAD = { cx: 540, cy: 560, rx: 175, ry: 150 }; // huge round head, overlaps body top
const NECK = { x: 540, y: 668 };
const MOUTH_Y = 650;
const EYE_Y = 562;
const EYES_X = [466, 614];
const VEST_PATH =
  "M 462 706 Q 540 686 618 706 Q 646 748 636 800 Q 540 838 444 800 Q 434 748 462 706 Z";

// ---- turtle geometry (v3.3 ONE-PATH construction; facing LEFT) ----
// The body silhouette is ONE closed "rounded loaf" path (fat half-oval: big
// dome top, gently rounded sides and bottom corners, small rear tail nub
// folded into the same closed path). Mai (shell) and belly are REGIONS of
// that single path, split by the gently sagging EQUATOR curve — mai above
// (yellow + clipped scutes), belly below (cream + thin plastron hints) —
// both painted through a clipPath that references the body path itself.
// There is NO second shell object: the only outer strokes in the whole
// figure are (a) the body path, (b) the head, (c) the legs.
const TURT = {
  // anchor points (clockwise from bottom-left): soft bottom start (470,846)
  // -> left-bottom corner (400,780) -> left side (418,676) -> dome top
  // (540,612) -> right dome (672,700) -> right side (674,772) -> tail nub out
  // to (706,800) and back (674,818) -> right-bottom corner (620,846) -> bottom
  // sag ~851 -> close. Extents ~x397..707 (incl. tail), y612..851.
  bodyPath:
    "M 470 846 C 430 846 405 824 400 780 " +
    "C 396 742 400 706 418 676 " +
    "C 442 638 486 612 540 612 " +
    "C 606 612 660 646 672 700 " +
    "C 678 728 678 752 674 772 " +
    "C 690 778 706 786 706 800 " +
    "C 706 812 692 820 674 818 " +
    "C 664 828 648 842 620 846 " +
    "C 588 851 520 851 470 846 Z",
  // equator (mai rim): gentle sag (center y796), both ends ON the body edge
  equatorPath: "M 398 770 Q 540 822 675 770",
  head: { cx: 445, cy: 600, rx: 108, ry: 92 }, // unchanged v3.2: single face anchor
  neck: { cx: 450, cy: 688 }, // head-tilt pivot ONLY (v3.3: no separate neck shape)
  legsFar: [505, 600], // cy 818 ry 44 — dark pair behind, tips peek below the loaf
  legsNear: [445, 648], // cy 812 ry 43 — in front of the belly, rising from lower body
  scutes: [
    { x: 568, y: 652, r: 24 },
    { x: 622, y: 700, r: 19 },
    { x: 490, y: 730, r: 21 },
    { x: 596, y: 742, r: 17 },
    { x: 432, y: 726, r: 15 },
  ],
};

// near-leg inward grip rotation (deg at full tGrip=1) for holding the book:
// front leg (cx 445) pivots NEGATIVE (SVG +rot swings a downward toe toward
// −x, so − brings its tip rightward onto the pages), rear leg (cx 648)
// pivots POSITIVE — both toes land on the book's outer page edges.
const TURT_GRIP_DEG = 72;

// Face layout DERIVED from TURT.head (v3.2 face relocation): offsets are the
// approved v3.1 values relative to the old head cx=352/cy=655. Changing
// TURT.head relocates the entire face, glasses included.
const T_FACE = {
  eyeY: TURT.head.cy - 25, // 630 = 655-25
  eyesX: [TURT.head.cx - 58, TURT.head.cx + 30], // [294,382] = 352-58/+30
  mouthX: TURT.head.cx - 40, // 312 = 352-40
  mouthY: TURT.head.cy + 61, // 716 = 655+61
  blushL: { x: TURT.head.cx - 80, y: TURT.head.cy + 27 }, // (272,682)
  blushR: { x: TURT.head.cx + 68, y: TURT.head.cy + 31 }, // (420,686)
  snout: { x: TURT.head.cx - 100, y: TURT.head.cy + 15 }, // (252,670)
  nostrilA: { x: TURT.head.cx - 105, y: TURT.head.cy + 10 }, // (247,665)
  nostrilB: { x: TURT.head.cx - 98, y: TURT.head.cy + 7 }, // (254,662)
};

// rounded-join hexagon path for shell spots (pure math, deterministic)
const hexPath = (cx: number, cy: number, r: number): string => {
  const pts: string[] = [];
  for (let k = 0; k < 6; k++) {
    const a = (Math.PI / 3) * k - Math.PI / 6;
    pts.push(`${(cx + r * Math.cos(a)).toFixed(1)} ${(cy + r * Math.sin(a)).toFixed(1)}`);
  }
  return `M ${pts.join(" L ")} Z`;
};

// 4-point sparkle star path (kawaii eye glint)
const star4 = (cx: number, cy: number, r: number): string =>
  `M ${cx} ${cy - r} Q ${cx + r * 0.15} ${cy - r * 0.15} ${cx + r} ${cy} ` +
  `Q ${cx + r * 0.15} ${cy + r * 0.15} ${cx} ${cy + r} ` +
  `Q ${cx - r * 0.15} ${cy + r * 0.15} ${cx - r} ${cy} ` +
  `Q ${cx - r * 0.15} ${cy - r * 0.15} ${cx} ${cy - r} Z`;

const TURTLE_VISEME_SCALE = 0.85; // turtle mouth is smaller than rabbit's

// ---------------------------------------------------------------------------
// TurtleFigure (v3.3): ONE-PATH construction. The whole shell+belly mass is
// a single closed "rounded loaf" path (rear tail nub included); mai and belly
// are painted as regions of that path through a clipPath, so the shell can
// never read as a second stacked object ("nap + hop" / lid-on-box). Outer
// strokes in the figure: (a) the body path, (b) the head overlapping the
// front-top edge (own stroke, no cut border), (c) the legs. Clip-path ids are
// global per SVG document -> ids are suffixed with `clipSuffix` and the
// turtle defs live INSIDE this component (local <defs> is legal SVG).
// Animation mechanics identical to v3.2: same props, same t* contract, head
// tilt still pivots at TURT.neck, face still derived from TURT.head.
// ---------------------------------------------------------------------------
export type TurtleBook = { x: number; bodyY: number; rot: number };

export type TurtleFigureProps = {
  tHeadX: number;
  tHeadY: number;
  tHeadTilt: number;
  tBodyDy: number;
  tEyeSy: number;
  tArcOp: number;
  tLookX: number;
  tMouth: { rx: number; ry: number };
  tMouthOp: number;
  tTongueOp: number;
  tSmileOp: number;
  tSmileW: number;
  tSmileD: number;
  book: TurtleBook | null;
  tGrip: number; // 0 = legs down (no book / released), 1 = full inward grip on the book
  clipSuffix: string;
};

export const TurtleFigure: React.FC<TurtleFigureProps> = ({
  tHeadX,
  tHeadY,
  tHeadTilt,
  tBodyDy,
  tEyeSy,
  tArcOp,
  tLookX,
  tMouth,
  tMouthOp,
  tTongueOp,
  tSmileOp,
  tSmileW,
  tSmileD,
  book,
  tGrip,
  clipSuffix,
}) => {
  const headClip = `ms-t-head-clip-${clipSuffix}`;
  const mouthClip = `ms-t-mouth-clip-${clipSuffix}`;
  const bodyClip = `ms-t-body-clip-${clipSuffix}`;
  return (
    <g>
      <defs>
        {/* v3.3: mai + belly + all interior pattern clip to the ONE body path */}
        <clipPath id={bodyClip}>
          <path d={TURT.bodyPath} />
        </clipPath>
        <clipPath id={headClip}>
          <ellipse cx={TURT.head.cx} cy={TURT.head.cy} rx={TURT.head.rx} ry={TURT.head.ry} />
        </clipPath>
        <clipPath id={mouthClip}>
          <ellipse
            cx={T_FACE.mouthX}
            cy={T_FACE.mouthY}
            rx={Math.max(tMouth.rx, 0.01)}
            ry={Math.max(tMouth.ry, 0.01)}
          />
        </clipPath>
      </defs>

      {/* ground shadow (stays put while the body bobs) */}
      <ellipse cx={540} cy={858} rx={160} ry={26} fill="#2e5d34" opacity={0.22} />

      <g transform={`translate(0 ${tBodyDy.toFixed(2)})`}>
        {/* far legs (darker olive, BEHIND the body; tips peek below the loaf) */}
        {TURT.legsFar.map((lx) => (
          <ellipse
            key={`far-${lx}`}
            cx={lx}
            cy={818}
            rx={26}
            ry={44}
            fill="#7f8f38"
            stroke={OUT}
            strokeWidth={10}
            strokeLinejoin="round"
          />
        ))}

        {/* z1 BODY — the ONE closed "rounded loaf" path = the entire shell +
            belly mass (tail nub included). Belly base fill first, then every
            interior detail (mai, scutes, sheen, plastron hints, rim line)
            painted through the body clip, then the single outline on top.
            No second shell object exists anywhere. */}
        <path d={TURT.bodyPath} fill="#f5e6c8" />
        <g clipPath={`url(#${bodyClip})`}>
          {/* mai = region ABOVE the equator, INSIDE the same body path */}
          <path d="M 398 770 Q 540 822 675 770 L 675 560 L 398 560 Z" fill="#f2b53c" />
          {/* scutes: interior pattern only — hexes sit fully inside the mai,
              never touching the silhouette, so they cannot read as outlines */}
          {TURT.scutes.map((sp) => (
            <path
              key={`scute-${sp.x}-${sp.y}`}
              d={hexPath(sp.x, sp.y, sp.r)}
              fill="#e8724a"
              stroke={OUT}
              strokeWidth={8}
              strokeLinejoin="round"
            />
          ))}
          {/* soft sheen */}
          <ellipse
            cx={610}
            cy={655}
            rx={40}
            ry={18}
            fill="#ffffff"
            opacity={0.22}
            transform="rotate(-25 610 655)"
          />
          {/* belly plastron hints: thin horizontals, clipped, no outline */}
          <g fill="none" stroke={OUT} strokeWidth={4} strokeLinecap="round" opacity={0.3}>
            <path d="M 452 816 Q 540 826 628 816" />
            <path d="M 468 838 Q 540 846 612 838" />
          </g>
          {/* mai rim: ONE thin single stroke along the equator curve */}
          <path
            d={TURT.equatorPath}
            fill="none"
            stroke="#c9821e"
            strokeWidth={6}
            strokeLinecap="round"
          />
        </g>
        {/* the ONLY body outline stroke of the whole figure */}
        <path
          d={TURT.bodyPath}
          fill="none"
          stroke={OUT}
          strokeWidth={13}
          strokeLinejoin="round"
          strokeLinecap="round"
        />

        {/* z2 head group: peek extend/retract + speaking/listening nod + proud tilt */}
        <g
          transform={`translate(${tHeadX.toFixed(2)} ${tHeadY.toFixed(2)}) ${piv(TURT.neck.cx, TURT.neck.cy, tHeadTilt)}`}
        >
          {/* v3.3: no separate neck shape — the head's own overlap with the
              body IS the neck: head drawn over the body, keeps its full
              stroke, no cut border slices it (tilt still pivots at neck) */}
          {/* head with soft top-left highlight */}
          <ellipse
            cx={TURT.head.cx}
            cy={TURT.head.cy}
            rx={TURT.head.rx}
            ry={TURT.head.ry}
            fill="#94a344"
          />
          <g clipPath={`url(#${headClip})`}>
            <ellipse
              cx={TURT.head.cx - 8}
              cy={TURT.head.cy - 6}
              rx={TURT.head.rx - 2}
              ry={TURT.head.ry - 2}
              fill="#a8b755"
            />
          </g>
          <ellipse
            cx={TURT.head.cx}
            cy={TURT.head.cy}
            rx={TURT.head.rx}
            ry={TURT.head.ry}
            fill="none"
            stroke={OUT}
            strokeWidth={14}
            strokeLinejoin="round"
          />

          {/* blush: deeper candy-pink ovals, gently tilted */}
          <ellipse
            cx={T_FACE.blushL.x}
            cy={T_FACE.blushL.y}
            rx={27}
            ry={16}
            fill="#ff9db4"
            opacity={0.8}
            transform={`rotate(-10 ${T_FACE.blushL.x} ${T_FACE.blushL.y})`}
          />
          <ellipse
            cx={T_FACE.blushR.x}
            cy={T_FACE.blushR.y}
            rx={27}
            ry={16}
            fill="#ff9db4"
            opacity={0.8}
            transform={`rotate(10 ${T_FACE.blushR.x} ${T_FACE.blushR.y})`}
          />

          {/* eyes: glossy sparkle (gentler than rabbit — no star); blink arc */}
          {T_FACE.eyesX.map((ex) => (
            <g key={`teye-${ex}`}>
              <g transform={piv(ex, T_FACE.eyeY, 0, 1, tEyeSy)}>
                <ellipse cx={ex + tLookX} cy={T_FACE.eyeY} rx={19} ry={23} fill={OUT} />
                <circle cx={ex + tLookX - 5.5} cy={T_FACE.eyeY - 7} r={6} fill="#ffffff" opacity={0.97} />
                <circle cx={ex + tLookX + 6} cy={T_FACE.eyeY + 8} r={2.6} fill="#ffffff" opacity={0.9} />
              </g>
              <path
                d={`M ${ex - 18} ${T_FACE.eyeY + 3} Q ${ex} ${T_FACE.eyeY - 11} ${ex + 18} ${T_FACE.eyeY + 3}`}
                fill="none"
                stroke={OUT}
                strokeWidth={8}
                strokeLinecap="round"
                strokeLinejoin="round"
                opacity={tArcOp}
              />
            </g>
          ))}

          {/* v3.1 glasses: round rims at NOMINAL eye x (eyes glance a few
              px behind the rims, like real glasses); bridge + temples hook
              back over the "ears". Static geometry inside the head group
              but OUTSIDE the blink scaleY group -> rings never shrink.
              v3.2: bridge/temples derived from head + eyeY (see T_FACE). */}
          {T_FACE.eyesX.map((ex) => (
            <ellipse
              key={`glass-${ex}`}
              cx={ex}
              cy={T_FACE.eyeY}
              rx={27}
              ry={31}
              fill="none"
              stroke="#5b3a2f"
              strokeWidth={7.5}
              strokeLinejoin="round"
            />
          ))}
          <path
            d={`M ${TURT.head.cx - 31} ${T_FACE.eyeY - 8} Q ${TURT.head.cx - 14} ${T_FACE.eyeY - 18} ${TURT.head.cx + 3} ${T_FACE.eyeY - 8}`}
            fill="none"
            stroke="#5b3a2f"
            strokeWidth={7}
            strokeLinecap="round"
          />
          <path
            d={`M ${TURT.head.cx + 57} ${T_FACE.eyeY - 4} Q ${TURT.head.cx + 76} ${T_FACE.eyeY - 12} ${TURT.head.cx + 88} ${T_FACE.eyeY + 4}`}
            fill="none"
            stroke="#5b3a2f"
            strokeWidth={7}
            strokeLinecap="round"
            strokeLinejoin="round"
          />
          <path
            d={`M ${TURT.head.cx - 85} ${T_FACE.eyeY - 4} Q ${TURT.head.cx - 104} ${T_FACE.eyeY - 12} ${TURT.head.cx - 109} ${T_FACE.eyeY + 7}`}
            fill="none"
            stroke="#5b3a2f"
            strokeWidth={7}
            strokeLinecap="round"
            strokeLinejoin="round"
          />

          {/* beak snout + nostrils */}
          <ellipse
            cx={T_FACE.snout.x}
            cy={T_FACE.snout.y}
            rx={13}
            ry={10}
            fill="#a8b755"
            stroke={OUT}
            strokeWidth={6}
            strokeLinejoin="round"
          />
          <circle cx={T_FACE.nostrilA.x} cy={T_FACE.nostrilA.y} r={2.6} fill={OUT} />
          <circle cx={T_FACE.nostrilB.x} cy={T_FACE.nostrilB.y} r={2.6} fill={OUT} />

          {/* mouth: open viseme ellipse crossfaded with closed smile arc + dimples */}
          {tMouth.rx > 0.5 ? (
            <g opacity={tMouthOp}>
              <ellipse
                cx={T_FACE.mouthX}
                cy={T_FACE.mouthY}
                rx={tMouth.rx}
                ry={tMouth.ry}
                fill="#5b3a3f"
                stroke={OUT}
                strokeWidth={6}
                strokeLinejoin="round"
              />
              {tTongueOp > 0.01 ? (
                <g clipPath={`url(#${mouthClip})`} opacity={tTongueOp}>
                  <ellipse
                    cx={T_FACE.mouthX}
                    cy={T_FACE.mouthY + tMouth.ry * 0.38}
                    rx={tMouth.rx * 0.62}
                    ry={tMouth.ry * 0.5}
                    fill="#ff8fa3"
                  />
                </g>
              ) : null}
            </g>
          ) : null}
          <path
            d={`M ${T_FACE.mouthX - tSmileW} ${T_FACE.mouthY - 6} Q ${T_FACE.mouthX} ${
              T_FACE.mouthY - 6 + tSmileD
            } ${T_FACE.mouthX + tSmileW} ${T_FACE.mouthY - 6}`}
            fill="none"
            stroke={OUT}
            strokeWidth={8}
            strokeLinecap="round"
            strokeLinejoin="round"
            opacity={tSmileOp}
          />
          <path
            d={`M ${T_FACE.mouthX - 40} ${T_FACE.mouthY - 3} Q ${T_FACE.mouthX - 47} ${
              T_FACE.mouthY + 4
            } ${T_FACE.mouthX - 45} ${T_FACE.mouthY + 11}`}
            fill="none"
            stroke={OUT}
            strokeWidth={4.5}
            strokeLinecap="round"
            strokeLinejoin="round"
            opacity={tSmileOp}
          />
          <path
            d={`M ${T_FACE.mouthX + 40} ${T_FACE.mouthY - 3} Q ${T_FACE.mouthX + 47} ${
              T_FACE.mouthY + 4
            } ${T_FACE.mouthX + 45} ${T_FACE.mouthY + 11}`}
            fill="none"
            stroke={OUT}
            strokeWidth={4.5}
            strokeLinecap="round"
            strokeLinejoin="round"
            opacity={tSmileOp}
          />
        </g>

        {/* v3.1 open book ("tay ôm"): drawn over the belly but UNDER the near
            legs (the near legs grip it — they render after this group so their
            toes paint over the pages). book.bodyY is body-local; main comp
            passes the −tBodyDy-compensated value so the LANDED book stays
            fixed on the ground while the body keeps bouncing. */}
        {book ? (
          <g
            transform={`translate(${(book.x - 548).toFixed(2)} ${(
              book.bodyY - 812
            ).toFixed(2)}) rotate(${book.rot.toFixed(2)} ${book.x.toFixed(2)} ${book.bodyY.toFixed(2)})`}
          >
            <path
              d="M 472 793 L 548 799 L 548 831 L 472 825 Z"
              fill="#fbf3dd"
              stroke={OUT}
              strokeWidth={7.5}
              strokeLinejoin="round"
              strokeLinecap="round"
            />
            <path
              d="M 624 793 L 548 799 L 548 831 L 624 825 Z"
              fill="#fbf3dd"
              stroke={OUT}
              strokeWidth={7.5}
              strokeLinejoin="round"
              strokeLinecap="round"
            />
            <path
              d="M 548 799 L 548 831"
              fill="none"
              stroke={OUT}
              strokeWidth={4.5}
              strokeLinecap="round"
            />
            <g
              fill="none"
              stroke={OUT}
              strokeWidth={3.2}
              strokeLinecap="round"
              opacity={0.5}
            >
              <path d="M 481 803 L 524 806.4" />
              <path d="M 481 811 L 526 814.8" />
              <path d="M 481 819 L 509 821.2" />
              <path d="M 572 806.4 L 615 803" />
              <path d="M 570 814.8 L 615 811" />
              <path d="M 587 821.2 L 615 819" />
            </g>
          </g>
        ) : null}

        {/* near legs (green, in FRONT of the belly — round legs rising from
            the lower body; the only other outlines besides body + head).
            v3.3 GRIP FIX: rendered AFTER the book so when tGrip>0 the legs
            rotate inward (front leg −TURT_GRIP_DEG, rear +TURT_GRIP_DEG,
            pivot (lx, 786) = top of each leg) and their toes land ON the
            book's pages across its outer edges — the book no longer reads
            as floating on the belly. Toe lines stay inside the group and
            rotate with the leg; tGrip=0 is an identity transform. */}
        {TURT.legsNear.map((lx, li) => (
          <g
            key={`near-${lx}`}
            transform={piv(lx, 786, (li === 0 ? -1 : 1) * TURT_GRIP_DEG * tGrip)}
          >
            <ellipse
              cx={lx}
              cy={812}
              rx={31}
              ry={43}
              fill="#94a344"
              stroke={OUT}
              strokeWidth={10}
              strokeLinejoin="round"
            />
            <line
              x1={lx - 10}
              y1={840}
              x2={lx - 10}
              y2={854}
              stroke={OUT}
              strokeWidth={6}
              strokeLinecap="round"
              opacity={0.85}
            />
            <line
              x1={lx + 10}
              y1={840}
              x2={lx + 10}
              y2={854}
              stroke={OUT}
              strokeWidth={6}
              strokeLinecap="round"
              opacity={0.85}
            />
          </g>
        ))}
      </g>
    </g>
  );
};

// ---- staging (1080x1080, ground y=856): scales unchanged from duet ----
const RABBIT_S = 0.78;
const TURTLE_S = 0.62;

const TITLE_TEXT = "Rùa và Thỏ 🐰🐢";
const TITLE_FONT =
  "'Baloo 2','Arial Rounded MT Bold','Comic Sans MS',system-ui,sans-serif";

// ================= scene map (authoritative, per TASK_MULTISCENE v2 brief) =================
// S1 meadow 0->9.43 · S2 start line 9.43->18.33 · S3 oak 18.33->27.59
// S4 sunset 27.59->32.40 · S5 finish 32.40->39.62   (sc4_path.png NOT used)
const SCENE_BGS = [
  "character-performer/kids/k_bg_clean.png",
  "character-performer/kids/scenes/sc2_race.png",
  "character-performer/kids/scenes/sc3_tree.png",
  "character-performer/kids/scenes/sc5_sunset.png",
  "character-performer/kids/scenes/sc6_finish.png",
];
// crossfade windows 0.5s centered at scene boundaries (gap centers)
const XFADES = [9.43, 18.33, 27.59, 32.4];
const XF = 0.25; // half window

// Ken Burns per scene: scale s0->s1 + drift (each scene a different direction;
// S3 pure push-in, no drift — turtle's walk is the scene's primary motion)
type CamDef = { t0: number; t1: number; s0: number; s1: number; tx0: number; tx1: number; ty0: number; ty1: number };
const CAMS: CamDef[] = [
  { t0: 0.0, t1: 9.43, s0: 1.03, s1: 1.08, tx0: 0, tx1: 0, ty0: 0, ty1: -10 }, // S1 push-in + rise
  { t0: 9.43, t1: 18.33, s0: 1.08, s1: 1.03, tx0: 0, tx1: -10, ty0: 0, ty1: 0 }, // S2 pull-out + pan left
  { t0: 18.33, t1: 27.59, s0: 1.03, s1: 1.08, tx0: 0, tx1: 0, ty0: 0, ty1: 0 }, // S3 pure push-in
  { t0: 27.59, t1: 32.4, s0: 1.03, s1: 1.08, tx0: 0, tx1: 10, ty0: 0, ty1: -6 }, // S4 push-in + right drift
  { t0: 32.4, t1: 39.62, s0: 1.08, s1: 1.03, tx0: 0, tx1: 0, ty0: 0, ty1: 4 }, // S5 pull-out reveal
];

const camOf = (i: number, tt: number) => {
  const c = CAMS[i];
  const p = clamp01((tt - c.t0) / (c.t1 - c.t0));
  return {
    s: lerp(c.s0, c.s1, p),
    tx: lerp(c.tx0, c.tx1, p),
    ty: lerp(c.ty0, c.ty1, p),
  };
};

// camera at time t: inside a crossfade window, BLEND (lerp easeInOutCubic)
// outgoing-scene-end params with incoming-scene-start params
const cameraAt = (tt: number) => {
  for (let i = 0; i < XFADES.length; i++) {
    const c = XFADES[i];
    if (tt >= c - XF && tt < c + XF) {
      const b = EIO(clamp01((tt - (c - XF)) / (2 * XF)));
      const A = camOf(i, c + 1); // clamps to scene end (p=1)
      const B = camOf(i + 1, c - 1); // clamps to scene start (p=0)
      return {
        s: lerp(A.s, B.s, b),
        tx: lerp(A.tx, B.tx, b),
        ty: lerp(A.ty, B.ty, b),
      };
    }
  }
  for (let i = 0; i < CAMS.length; i++) {
    if (tt >= CAMS[i].t0 && tt < CAMS[i].t1) return camOf(i, tt);
  }
  return camOf(CAMS.length - 1, tt);
};

// ================= dynamic staging =================
// Characters slide across transition windows (0.75s easeInOutCubic, covering
// the 0.5s crossfade), hold still mid-scene. Turtle additionally WALKS left
// 640->260 linearly through i5 (23.0->26.9) with a small waddle bob.
const SLIDE_DUR = 0.75;
const slideP = (tt: number, center: number) =>
  EIO(clamp01((tt - (center - SLIDE_DUR / 2)) / SLIDE_DUR));

const WALK_T0 = 23.0;
const WALK_T1 = 26.9;

const rabbitXAt = (tt: number): number => {
  let x = 346; // S1
  x = lerp(x, 366, slideP(tt, 9.43)); // T12
  x = lerp(x, 740, slideP(tt, 18.33)); // T23 — under the oak on the right
  x = lerp(x, 640, slideP(tt, 27.59)); // T34
  x = lerp(x, 700, slideP(tt, 32.4)); // T45 — beside turtle at the finish
  return x;
};

const turtleXAt = (tt: number): number => {
  let x = 734; // S1
  x = lerp(x, 714, slideP(tt, 9.43)); // T12
  x = lerp(x, 640, slideP(tt, 18.33)); // T23
  // steady slow walk left through i5 — LINEAR pace (bền bỉ đi đều)
  const walkP = clamp01((tt - WALK_T0) / (WALK_T1 - WALK_T0));
  x = lerp(x, 260, walkP);
  x = lerp(x, 430, slideP(tt, 32.4)); // T45 — finish center, under banner
  return x;
};

// ================= confetti (deterministic arithmetic hash — no random) =================
const CONF_N = 36;
const CONF_START = 33.1;
const CONF_FALL = 6.5; // 33.1 -> 39.6
const CONF_COLORS = ["#e8503a", "#e8724a", "#f2b53c", "#ffb3c0", "#ffffff"];

export const KidsStoryMultiScene: React.FC = () => {
  const frame = useCurrentFrame();
  const { fps } = useVideoConfig();
  const t = frame / fps;

  // ================= camera + staging =================
  const cam = cameraAt(t);
  const rabbitX = rabbitXAt(t);
  const turtleX = turtleXAt(t);

  // ================= bg crossfade opacities =================
  const fade = (a: number, b: number, from: number, to: number) =>
    interpolate(t, [a, b], [from, to], {
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });
  const bgOps = [
    fade(9.18, 9.68, 1, 0),
    fade(9.18, 9.68, 0, 1) * fade(18.08, 18.58, 1, 0),
    fade(18.08, 18.58, 0, 1) * fade(27.34, 27.84, 1, 0),
    fade(27.34, 27.84, 0, 1) * fade(32.15, 32.65, 1, 0),
    fade(32.15, 32.65, 0, 1),
  ];

  // ================= speech state =================
  const line = activeLine(t);
  const speaker: "rabbit" | "turtle" | null = line ? line.who : null;

  // rabbit reaction beats: sleep (i4 tail) -> wake startled (i6 start)
  const sleepIn = interpolate(t, [21.35, 21.85], [0, 1], {
    easing: EOC,
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });
  const sleepOut = interpolate(t, [27.69, 27.83], [1, 0], {
    easing: EIC,
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });
  const asleep = sleepIn * sleepOut;
  const wakePop =
    interpolate(t, [27.69, 28.01], [0, 1], {
      easing: EASE_OUT_BACK,
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    }) *
    interpolate(t, [27.94, 28.79], [1, 0], {
      easing: EOC,
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });
  const jerkUp =
    interpolate(t, [27.69, 27.87], [0, 1], {
      easing: EASE_OUT_BACK,
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    }) *
    interpolate(t, [27.91, 28.54], [1, 0], {
      easing: EOC,
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });

  // turtle proud pose: during i7 + ~1s after (release by ~39.2)
  const proud =
    interpolate(t, [32.6, 33.2], [0, 1], {
      easing: EOC,
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    }) *
    interpolate(t, [38.55, 39.15], [1, 0], {
      easing: EOC,
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });

  // cue lookup: ONLY the speaker lip-syncs, on that line's cues + start offset
  const rMouth0 =
    speaker === "rabbit" && line ? mouthAtCues(LINE_CUES[line.i], t - line.start) : VISEMES.X;
  const tMouth0 =
    speaker === "turtle" && line ? mouthAtCues(LINE_CUES[line.i], t - line.start) : VISEMES.X;
  const rMouth = { rx: rMouth0.rx * (1 - asleep), ry: rMouth0.ry * (1 - asleep) };
  const tMouth = {
    rx: tMouth0.rx * TURTLE_VISEME_SCALE,
    ry: tMouth0.ry * TURTLE_VISEME_SCALE,
  };

  // smooth speech envelopes (nod amplitude, head extension, listener nod)
  const envR = LINES.filter((l) => l.who === "rabbit").reduce(
    (acc, l) => acc + envAt(t, l.start - 0.15, l.start, l.start + l.dur - 0.2, l.start + l.dur + 0.1),
    0
  );
  const envT = LINES.filter((l) => l.who === "turtle").reduce(
    (acc, l) => acc + envAt(t, l.start - 0.15, l.start, l.start + l.dur - 0.2, l.start + l.dur + 0.1),
    0
  );

  // ================= rabbit anim state =================
  const rBlinkRaw = blinkFrom(RABBIT_BLINKS, t);
  const rBlink = Math.max(rBlinkRaw, asleep); // eyes stay closed while asleep
  const hop = hopState(t);
  const breathe = Math.sin((Math.PI * 2 * t) / 3.6);
  const rTiltSway = 2.5 * Math.sin(Math.PI * 2 * 0.13 * t);
  const rHeadTilt = rTiltSway + 8 * asleep - 5 * wakePop;
  const rSpeakNod = Math.sin(t * Math.PI * 2 * 2.2) * 1.5 * Math.min(1, envR);
  const rListenNod = Math.sin(t * Math.PI * 2 * 0.9) * 1.2 * Math.min(1, envT) * (1 - asleep);
  const rHeadY = 1.5 * breathe + rSpeakNod + rListenNod + 11 * asleep - 4 * wakePop;
  const earSway = Math.sin(Math.PI * 2 * 0.55 * t) * 2;
  const earRotL = earSway - 24 * asleep + 16 * wakePop;
  const earRotR = -earSway + 24 * asleep - 16 * wakePop;

  // pupil look direction generalized to dynamic positions: look toward the
  // other character wherever it currently stands
  const lookDir = Math.sign(turtleX - rabbitX); // +1 turtle right of rabbit
  const rLookX = speaker === "rabbit" ? 0 : 5 * lookDir; // listening / idle
  const tLookX = speaker === "turtle" ? -2 * lookDir : -5 * lookDir;

  const rOpenness = clamp01(rMouth.ry / 12);
  const rSmileOp = clamp01(1 - rOpenness);
  const rMouthOp = clamp01(rOpenness * 1.15);
  const rTongueOp = clamp01((rMouth.ry - 12) / 8);
  const rEyeSy = 1 - 0.95 * rBlink;
  const rEyeWide = 1 + 0.16 * wakePop;
  const rArcOp = clamp01((rBlink - 0.55) / 0.3);
  const rCheekLift = 2 * rBlink;
  const airFrac = clamp01(-hop.dy / 40);
  const rShScale = 1 - 0.18 * airFrac;
  const rShOp = 0.25 - 0.09 * airFrac;

  // S5 clap: 1.5Hz swing between open (±13° base) and meet (±52°, fingertips
  // nearly touching in front of chest) from 33.7 to 39.2
  const clapEnv =
    interpolate(t, [33.7, 33.9], [0, 1], {
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    }) *
    interpolate(t, [39.0, 39.2], [1, 0], {
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });
  const clapMeet = Math.abs(Math.sin(Math.PI * 1.5 * (t - 33.7)));
  const clapSwing = clapMeet * clapEnv; // 0 = open, 1 = meet
  const armRotL = 13 + 39 * clapSwing; // coefficient: 13 -> 52
  const armRotR = 13 + 39 * clapSwing;
  const bodySx =
    hop.sx * (1 - 0.004 * breathe) * (1 + 0.01 * (2 * clapSwing - 1) * clapEnv);
  const bodySy = hop.sy * (1 + 0.012 * breathe);

  // ================= turtle anim state =================
  const tBlink = blinkFrom(TURTLE_BLINKS, t);
  const tBreathe = Math.sin((Math.PI * 2 * t) / 5); // slower, calmer than rabbit
  const peek = Math.sin((Math.PI * 2 * t) / 4);
  const tHeadX = -(5 + 5 * peek) - 5 * Math.min(1, envT);
  const tSpeakNod = Math.sin(t * Math.PI * 2 * 1.1) * 2.2 * Math.min(1, envT);
  const tListenNod = Math.sin(t * Math.PI * 2 * 0.85) * 1.6 * Math.min(1, envR);
  const tHeadY = 1.2 * tBreathe + tSpeakNod + tListenNod - 6 * proud;
  const tHeadTilt = 1.5 * Math.sin(Math.PI * 2 * 0.09 * t) + 7 * proud;

  // walk waddle bob (local coords; ×0.62 -> ~±2.5 world px), only while walking
  const walkActive = t >= WALK_T0 && t < WALK_T1;
  const walkBob = walkActive
    ? 4 * Math.abs(Math.sin(Math.PI * 2 * 0.9 * (t - WALK_T0)))
    : 0;
  // S5 proud gentle bounce (small amplitude, does not break i7 lip-sync)
  const proudBounce = -10 * Math.abs(Math.sin(Math.PI * 2 * 1.2 * (t - 33.2))) * proud;
  const tBodyDy = -3 * proud + proudBounce - walkBob;

  const tOpenness = clamp01(tMouth.ry / 10);
  const tSmileOp = clamp01(1 - tOpenness);
  const tMouthOp = clamp01(tOpenness * 1.15);
  const tTongueOp = clamp01((tMouth.ry - 10) / 7);
  const tEyeSy = 1 - 0.95 * tBlink;
  const tArcOp = clamp01((tBlink - 0.55) / 0.3);
  const tSmileW = 36 + 8 * proud;
  const tSmileD = 26 + 6 * proud;

  // ================= v3.1 held book ("tay ôm") + S5 drop =================
  // Held at local center (548, 812), rides the body bob. Dropped BEFORE the
  // celebration: easeInQuad fall 32.80->33.08 from held position to lying
  // beside the LEFT front foot, tiny ±3px settle bounce 33.08->33.25, then
  // parked for the rest of the video. Pure function of t.
  const bookFallP = interpolate(t, [32.8, 33.08], [0, 1], {
    easing: Easing.in(Easing.quad),
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });
  // near legs grip the book while it is held; release smoothly during the fall
  const tGrip = 1 - bookFallP;
  const bookSettleQ = clamp01((t - 33.08) / (33.25 - 33.08));
  const bookSettleDy = -3 * Math.sin(Math.PI * bookSettleQ);
  const bookHeldY = 812 + tBodyDy; // rides body bob (walk bob / proud bounce)
  const bookGroundY =
    t < 33.08 ? lerp(bookHeldY, 834, bookFallP) : 834 + bookSettleDy;
  const bookX = lerp(548, 350, bookFallP);
  const bookRot = lerp(0, -12, bookFallP);
  // book is drawn inside the tBodyDy group; subtract tBodyDy from the LANDED
  // position so the parked book stays fixed on the ground while the body
  // keeps bouncing (proud bounce) — net world position = (bookX, bookGroundY).
  const bookBodyY = bookGroundY - tBodyDy;

  // ================= title (outside camera layer) =================
  const titleP = interpolate(frame, [0, 18], [0, 1], {
    easing: EASE_OUT_BACK,
    extrapolateLeft: "clamp",
    extrapolateRight: "clamp",
  });
  const titleY = -60 * (1 - titleP);
  const titleOp =
    interpolate(frame, [0, 8], [0, 1], {
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    }) *
    interpolate(frame, [60, 75], [1, 0], {
      extrapolateLeft: "clamp",
      extrapolateRight: "clamp",
    });

  // ================= zZz (world coords, anchored to CURRENT rabbit x) =================
  const zzzs = [
    { dx: 62, y: 478, s: 26 },
    { dx: 88, y: 443, s: 34 },
    { dx: 116, y: 406, s: 44 },
  ];

  return (
    <AbsoluteFill style={{ backgroundColor: "#bfe6f5" }}>
      {/* ============ CAMERA CONTAINER — bg stack + world SVG move together ============ */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          transform: `scale(${cam.s}) translate(${cam.tx}px, ${cam.ty}px)`,
          transformOrigin: "50% 50%",
        }}
      >
        {/* bg stack: 5 full-bleed images, opacity per crossfade windows */}
        {SCENE_BGS.map((bg, i) => (
          <Img
            key={bg}
            src={staticFile(bg)}
            style={{
              position: "absolute",
              inset: 0,
              width: "100%",
              height: "100%",
              objectFit: "cover",
              opacity: bgOps[i],
            }}
          />
        ))}

        {/* ============ world SVG (viewBox 1080x1080): turtle, rabbit, zZz, confetti ============ */}
        <svg
          viewBox="0 0 1080 1080"
          style={{ position: "absolute", inset: 0, width: "100%", height: "100%" }}
        >
          <defs>
            {/* rabbit clips (turtle clips live inside <TurtleFigure>, ids
                suffixed per instance since 3 turtles share one SVG doc) */}
            <clipPath id="ms-r-body-clip">
              <ellipse cx={BODY.cx} cy={BODY.cy} rx={BODY.rx} ry={BODY.ry} />
            </clipPath>
            <clipPath id="ms-r-head-clip">
              <ellipse cx={HEAD.cx} cy={HEAD.cy} rx={HEAD.rx} ry={HEAD.ry} />
            </clipPath>
            <clipPath id="ms-r-mouth-clip">
              <ellipse
                cx={540}
                cy={MOUTH_Y}
                rx={Math.max(rMouth.rx, 0.01)}
                ry={Math.max(rMouth.ry, 0.01)}
              />
            </clipPath>
          </defs>

          {/* ==================== TURTLE (facing left, dynamic x) ==================== */}
          {/* v3.3: one-path construction lives in <TurtleFigure> above —
              same t* mechanics, geometry rebuilt (single loaf path + clip
              regions). Main comp only passes the computed animation values. */}
          <g transform={`translate(${turtleX.toFixed(1)} 856) scale(${TURTLE_S}) translate(-540 -856)`}>
            <TurtleFigure
              tHeadX={tHeadX}
              tHeadY={tHeadY}
              tHeadTilt={tHeadTilt}
              tBodyDy={tBodyDy}
              tEyeSy={tEyeSy}
              tArcOp={tArcOp}
              tLookX={tLookX}
              tMouth={tMouth}
              tMouthOp={tMouthOp}
              tTongueOp={tTongueOp}
              tSmileOp={tSmileOp}
              tSmileW={tSmileW}
              tSmileD={tSmileD}
              book={{ x: bookX, bodyY: bookBodyY, rot: bookRot }}
              tGrip={tGrip}
              clipSuffix="main"
            />
          </g>


          {/* ==================== RABBIT (facing right, dynamic x) ==================== */}
          <g transform={`translate(${rabbitX.toFixed(1)} 856) scale(${RABBIT_S}) translate(-540 -856)`}>
            {/* startled wake: whole-body jump with easeOutBack overshoot */}
            <g transform={`translate(0 ${(-24 * jerkUp).toFixed(2)})`}>
              {/* ground shadow (stays on ground, shrinks + fades when airborne) */}
              <ellipse
                cx={540}
                cy={858}
                rx={150 * rShScale}
                ry={30 * rShScale}
                fill="#2e5d34"
                opacity={rShOp}
              />

              {/* whole-rabbit hop translation */}
              <g transform={`translate(0 ${hop.dy.toFixed(2)})`}>
                {/* squash-stretch + breathing + clap micro-pulse, pivot at feet */}
                <g transform={piv(540, FEET_Y, 0, bodySx, bodySy)}>
                  {/* tail puff (behind body) */}
                  <ellipse cx={415} cy={770} rx={30} ry={28} fill="#ffffff" stroke={OUT} strokeWidth={10} strokeLinejoin="round" />

                  {/* ears — droop outward asleep, shoot upright startled; 3-layer pink */}
                  <g transform={piv(NECK.x, NECK.y, rHeadTilt)}>
                    <g transform={piv(496, 480, earRotL)}>
                      <ellipse cx={496} cy={402} rx={33} ry={78} fill="#ffffff" stroke={OUT} strokeWidth={12} strokeLinejoin="round" />
                      <ellipse cx={496} cy={412} rx={17} ry={52} fill="#ffc9d6" />
                      <ellipse cx={496} cy={418} rx={12} ry={42} fill="#ff9fb6" />
                      <ellipse cx={496} cy={426} rx={7} ry={30} fill="#ff7fa2" />
                    </g>
                    <g transform={piv(584, 480, earRotR)}>
                      <ellipse cx={584} cy={402} rx={33} ry={78} fill="#ffffff" stroke={OUT} strokeWidth={12} strokeLinejoin="round" />
                      <ellipse cx={584} cy={412} rx={17} ry={52} fill="#ffc9d6" />
                      <ellipse cx={584} cy={418} rx={12} ry={42} fill="#ff9fb6" />
                      <ellipse cx={584} cy={426} rx={7} ry={30} fill="#ff7fa2" />
                    </g>
                  </g>

                  {/* body with warm rim shading */}
                  <ellipse cx={BODY.cx} cy={BODY.cy} rx={BODY.rx} ry={BODY.ry} fill="#f3ebe4" />
                  <g clipPath="url(#ms-r-body-clip)">
                    <ellipse cx={BODY.cx - 8} cy={BODY.cy - 5} rx={BODY.rx - 1} ry={BODY.ry - 1} fill="#ffffff" />
                  </g>
                  <ellipse
                    cx={BODY.cx}
                    cy={BODY.cy}
                    rx={BODY.rx}
                    ry={BODY.ry}
                    fill="none"
                    stroke={OUT}
                    strokeWidth={14}
                    strokeLinejoin="round"
                  />

                  {/* red vest with darker rim + white buttons */}
                  <path d={VEST_PATH} fill="#e8503a" stroke={OUT} strokeWidth={10} strokeLinejoin="round" />
                  <path d="M 452 788 Q 540 828 628 788" fill="none" stroke="#c23a28" strokeWidth={8} strokeLinecap="round" strokeLinejoin="round" />
                  <path d="M 540 700 Q 543 764 540 828" fill="none" stroke="#c23a28" strokeWidth={5} strokeLinecap="round" strokeLinejoin="round" />
                  <circle cx={540} cy={752} r={10} fill="#ffffff" stroke="#c23a28" strokeWidth={4.5} strokeLinejoin="round" />
                  <circle cx={540} cy={794} r={10} fill="#ffffff" stroke="#c23a28" strokeWidth={4.5} strokeLinejoin="round" />

                  {/* feet (stubby) */}
                  {[502, 578].map((fx) => (
                    <g key={fx}>
                      <ellipse cx={fx} cy={852} rx={48} ry={25} fill="#ffffff" stroke={OUT} strokeWidth={10} strokeLinejoin="round" />
                      <line x1={fx - 12} y1={841} x2={fx - 12} y2={855} stroke={OUT} strokeWidth={6} strokeLinecap="round" opacity={0.85} />
                      <line x1={fx + 12} y1={841} x2={fx + 12} y2={855} stroke={OUT} strokeWidth={6} strokeLinecap="round" opacity={0.85} />
                    </g>
                  ))}

                  {/* arms (stub) — S5 clap: swing between open (±13°) and meet
                      (±52°) in front of chest; hop swing outward while airborne */}
                  <g transform={piv(468, 712, -(armRotL + hop.arm))}>
                    <ellipse cx={452} cy={748} rx={19} ry={38} fill="#ffffff" stroke={OUT} strokeWidth={10} strokeLinejoin="round" />
                  </g>
                  <g transform={piv(612, 712, armRotR + hop.arm)}>
                    <ellipse cx={628} cy={748} rx={19} ry={38} fill="#ffffff" stroke={OUT} strokeWidth={10} strokeLinejoin="round" />
                  </g>

                  {/* head group: nod/breathing + droop asleep, tilt about neck */}
                  <g transform={`translate(0 ${rHeadY.toFixed(2)}) ${piv(NECK.x, NECK.y, rHeadTilt)}`}>
                    <ellipse cx={HEAD.cx} cy={HEAD.cy} rx={HEAD.rx} ry={HEAD.ry} fill="#f3ebe4" />
                    <g clipPath="url(#ms-r-head-clip)">
                      <ellipse cx={HEAD.cx - 9} cy={HEAD.cy - 6} rx={HEAD.rx - 1} ry={HEAD.ry - 1} fill="#ffffff" />
                    </g>
                    <ellipse
                      cx={HEAD.cx}
                      cy={HEAD.cy}
                      rx={HEAD.rx}
                      ry={HEAD.ry}
                      fill="none"
                      stroke={OUT}
                      strokeWidth={14}
                      strokeLinejoin="round"
                    />

                    {/* blush: deep candy-pink ovals, tilted; lift on blink */}
                    <ellipse
                      cx={418}
                      cy={618 - rCheekLift}
                      rx={31}
                      ry={18}
                      fill="#ff9db4"
                      opacity={0.85}
                      transform="rotate(-10 418 618)"
                    />
                    <ellipse
                      cx={662}
                      cy={618 - rCheekLift}
                      rx={31}
                      ry={18}
                      fill="#ff9db4"
                      opacity={0.85}
                      transform="rotate(10 662 618)"
                    />

                    {/* eyes: glossy sparkle — halo + big top-left + small
                        bottom-right highlights + 4-point star; blink -> arc */}
                    {EYES_X.map((ex) => (
                      <g key={ex}>
                        <g transform={piv(ex, EYE_Y, 0, 1, rEyeSy * rEyeWide)}>
                          <ellipse cx={ex + rLookX} cy={EYE_Y} rx={22} ry={28} fill={OUT} />
                          <ellipse cx={ex + rLookX - 7} cy={EYE_Y - 9} rx={9} ry={11} fill="#ffffff" opacity={0.25} />
                          <circle cx={ex + rLookX - 7} cy={EYE_Y - 9} r={7} fill="#ffffff" opacity={0.97} />
                          <circle cx={ex + rLookX + 8} cy={EYE_Y + 10} r={3} fill="#ffffff" opacity={0.9} />
                          <path d={star4(ex + rLookX + 6, EYE_Y - 13, 4.5)} fill="#ffffff" opacity={0.92} />
                        </g>
                        <path
                          d={`M ${ex - 20} ${EYE_Y + 3} Q ${ex} ${EYE_Y - 12} ${ex + 20} ${EYE_Y + 3}`}
                          fill="none"
                          stroke={OUT}
                          strokeWidth={9}
                          strokeLinecap="round"
                          strokeLinejoin="round"
                          opacity={rArcOp}
                        />
                      </g>
                    ))}

                    {/* nose: rounded pink heart-ish */}
                    <path
                      d="M 524 608 Q 540 600 556 608 Q 550 624 540 630 Q 530 624 524 608 Z"
                      fill="#ff8fa3"
                      stroke={OUT}
                      strokeWidth={5}
                      strokeLinejoin="round"
                    />

                    {/* mouth: open viseme ellipse crossfaded with closed smile + dimples */}
                    {rMouth.rx > 0.5 ? (
                      <g opacity={rMouthOp}>
                        <ellipse
                          cx={540}
                          cy={MOUTH_Y}
                          rx={rMouth.rx}
                          ry={rMouth.ry}
                          fill="#5b3a3f"
                          stroke={OUT}
                          strokeWidth={6}
                          strokeLinejoin="round"
                        />
                        {rTongueOp > 0.01 ? (
                          <g clipPath="url(#ms-r-mouth-clip)" opacity={rTongueOp}>
                            <ellipse
                              cx={540}
                              cy={MOUTH_Y + rMouth.ry * 0.38}
                              rx={rMouth.rx * 0.62}
                              ry={rMouth.ry * 0.5}
                              fill="#ff8fa3"
                            />
                          </g>
                        ) : null}
                      </g>
                    ) : null}
                    <path
                      d="M 502 638 Q 540 672 578 638"
                      fill="none"
                      stroke={OUT}
                      strokeWidth={8}
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      opacity={rSmileOp}
                    />
                    <path
                      d="M 500 641 Q 490 649 492 658"
                      fill="none"
                      stroke={OUT}
                      strokeWidth={5}
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      opacity={rSmileOp}
                    />
                    <path
                      d="M 580 641 Q 590 649 588 658"
                      fill="none"
                      stroke={OUT}
                      strokeWidth={5}
                      strokeLinecap="round"
                      strokeLinejoin="round"
                      opacity={rSmileOp}
                    />
                  </g>
                </g>
              </g>
            </g>
          </g>

          {/* ==================== zZz above sleeping rabbit (world coords, follows rabbitX) ==================== */}
          {asleep > 0.02
            ? zzzs.map((z, idx) => {
                const ph = t * 0.6 + idx * 0.9;
                const wave = (Math.sin(Math.PI * 2 * ph) + 1) / 2; // 0..1
                return (
                  <text
                    key={`zzz-${idx}`}
                    x={rabbitX + z.dx}
                    y={z.y - 8 * wave}
                    fontFamily={TITLE_FONT}
                    fontSize={z.s}
                    fontWeight={800}
                    fill={OUT}
                    stroke="#ffffff"
                    strokeWidth={6}
                    strokeLinejoin="round"
                    paintOrder="stroke"
                    opacity={asleep * (0.35 + 0.55 * wave)}
                  >
                    z
                  </text>
                );
              })
            : null}

          {/* ==================== confetti (S5 celebration, deterministic hash) ==================== */}
          {Array.from({ length: CONF_N }, (_, k) => {
            const start = CONF_START + (k * 0.13) % 1.2;
            const local = t - start;
            if (local < 0) return null;
            const fallP = local / CONF_FALL;
            if (fallP >= 1) return null; // landed off-screen
            const x0 = (k * 97) % 1080;
            const size = 8 + (k % 7);
            const x = x0 + 16 * Math.sin(Math.PI * 2 * 0.35 * local + k);
            const y = lerp(-30, 1110, fallP);
            const rot = (k * 31 + 240 * local * (0.6 + 0.15 * (k % 5))) % 360;
            const op = clamp01(local / 0.4); // fade-in 0.4s
            const fill = CONF_COLORS[k % CONF_COLORS.length];
            return (
              <g
                key={`cf-${k}`}
                transform={`translate(${x.toFixed(1)} ${y.toFixed(1)}) rotate(${rot.toFixed(1)})`}
                opacity={op}
              >
                {k % 2 === 0 ? (
                  <rect x={-size / 2} y={-size / 2} width={size} height={size * 0.62} rx={1.5} fill={fill} />
                ) : (
                  <circle r={size / 2} fill={fill} />
                )}
              </g>
            );
          })}
        </svg>
      </div>

      {/* title card — centered both axes, outside camera layer; fade out by 2.5s */}
      <div
        style={{
          position: "absolute",
          inset: 0,
          display: "flex",
          alignItems: "center",
          justifyContent: "center",
          opacity: titleOp,
          transform: `translateY(${titleY}px)`,
          pointerEvents: "none",
        }}
      >
        <div
          style={{
            position: "relative",
            fontFamily: TITLE_FONT,
            fontSize: 96,
            fontWeight: 800,
            lineHeight: 1.15,
            whiteSpace: "nowrap",
          }}
        >
          <div
            style={{
              color: "transparent",
              WebkitTextStroke: "10px #ffffff",
              paintOrder: "stroke fill",
            }}
          >
            {TITLE_TEXT}
          </div>
          <div
            style={{
              position: "absolute",
              inset: 0,
              color: "#3a2e2a",
              textShadow: "0 3px 10px rgba(58,46,42,0.22)",
            }}
          >
            {TITLE_TEXT}
          </div>
        </div>
      </div>

      {/* 8 dialogue lines placed at their timeline `start` — gaps are >=0.45s, no overlap */}
      {LINES.map((l) => (
        <Sequence key={l.i} from={Math.round(l.start * fps)}>
          <Audio src={staticFile(`character-performer/kids/dialogue/d${l.i}_${l.who}.wav`)} />
        </Sequence>
      ))}
      <Audio src={staticFile("character-performer/kids/dialogue/bgm_dialogue.wav")} volume={0.42} />
    </AbsoluteFill>
  );
};
