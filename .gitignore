# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Local model downloads (e.g. Piper TTS voices, fetched at runtime — not source)
*.onnx
*.onnx.json

# Test/IDE
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.trae/
.idea/
.vscode/
*.bak
*.bak.*


# Pipeline outputs (regenerable — never commit large media)
output/
pipeline/
tests/qa/output/
out/


# Channel packs: track channel.yaml, docs, lexicons, mix profiles, SVGs; ignore heavy binaries
channels/*/assets/**
!channels/*/assets/**/
!channels/*/assets/**/*.md
!channels/*/assets/**/*.json
!channels/*/assets/**/*.yaml
!channels/*/assets/**/*.yml
!channels/*/assets/**/*.svg
!channels/*/assets/**/.gitkeep

# Project workspaces: media/renders/audio stay LOCAL (regenerable or too big);
# track per-project SOURCES + QC metadata only (scripts/, artifacts/, root *.json/*.md).
projects/*/*
!projects/*/scripts
!projects/*/artifacts
!projects/*/*.json
!projects/*/*.md
!projects/*/.gitkeep
# Nested channel episodes: traverse projects/<channel>/<episode>/ and track only sources/QC
# <channel-gitignore-rules>
!projects/ky-chu-diem-tin/*/
projects/ky-chu-diem-tin/*/*
!projects/ky-chu-diem-tin/*/scripts
!projects/ky-chu-diem-tin/*/artifacts
!projects/ky-chu-diem-tin/*/*.json
!projects/ky-chu-diem-tin/*/*.md
!projects/vn-myth/*/
projects/vn-myth/*/*
!projects/vn-myth/*/scripts
!projects/vn-myth/*/artifacts
!projects/vn-myth/*/*.json
!projects/vn-myth/*/*.md
!projects/ky-chu-phap-luat/*/
projects/ky-chu-phap-luat/*/*
!projects/ky-chu-phap-luat/*/scripts
!projects/ky-chu-phap-luat/*/artifacts
!projects/ky-chu-phap-luat/*/*.json
!projects/ky-chu-phap-luat/*/*.md
# </channel-gitignore-rules>
# M-A: the editorial-language gate's hashed evidence artifact is machine-
# generated per compose/audit run — never committable (validate_pre_render
# re-derives and re-hashes it; a stale committed copy would hash-mismatch).
projects/*/artifacts/editorial_language_evidence.json
projects/*/*/artifacts/editorial_language_evidence.json
# CC session task specs are working junk, not sources — never track
projects/**/TASK_*.md
# media & runtime junk never tracked, even inside whitelisted dirs
projects/**/__pycache__/
projects/**/*.png
projects/**/*.jpg
projects/**/*.jpeg
projects/**/*.wav
projects/**/*.mp3
projects/**/*.mp4
projects/**/*.mov
projects/**/*.webm
projects/**/*.zip
projects/**/*.pkl
projects/**/*.pt
projects/**/*.onnx

# Corpus directories (downloaded stock clips, thumbnails, embeddings —
# regenerable from source APIs via corpus_builder). Explicit rule even
# though most corpora live under projects/ since agents sometimes
# build scratch corpora at the repo root.
corpus/
**/corpus/

# User music library (personal royalty-free tracks — not part of repo)
music_library/

# Environment & credentials
.env
.env.local
*.env
.youtube-token.json
# Google service-account / Vertex AI keys — never commit
gcp-*.json
*-service-account.json
service-account*.json
service_account*.json

# Stray media downloads (test/scratch clips left in repo root)
pexels_video_*.mp4

# Scratch/debug scripts and ffmpeg 2-pass logs
scratch/
scratch_*
ffmpeg2pass-*.log*

# Internal docs (strategy, handoffs, playbooks — not shipped)
internal/

# Local agent config (user-specific)
.claude/memory/
.claude/settings.local.json

# Agent skills lock (local install tracking)
skills-lock.json

# Generated images (logo drafts — final logo lives in assets/)
logo_*.png
generated_image.png

# Downloaded music files (Pixabay, Freesound — not source code)
pixabay_music_*

# OS
.DS_Store
Thumbs.db

# Node (for remotion-composer/)
node_modules/

# Remotion build output, cache, and copied project assets (regenerable at render time)
remotion-composer/out/
.cache/
.remotion/
# Project-local bespoke ("atelier") compositions — hand-authored per video,
# throwaway and regenerable. Keeps the shared src/ free of one-off scenes.
remotion-composer/projects/
remotion-composer/public/*
# But keep demo props and shared film-grain textures (shipped with the project)
!remotion-composer/public/demo-props/
!remotion-composer/public/textures/

# Ignore test/scratch compositions in demo-props (keep only curated demos)
remotion-composer/public/demo-props/test-*
remotion-composer/public/demo-props/talking-head-*
remotion-composer/public/demo-props/caption-burn-*

venv/
.venv/

# Backlot local cache (thumbnails)
.backlot/

# Workspace-local third-party runtimes (for example the portable Blender LTS
# used by blender_world). These are checksum-verified but never committed.
.runtime/

# Local Wan / diffusers GPU environment
.venv-wan/

# regenerable heavy intermediates + agent session logs (2026-10-16)
character-performer/kids/turn7/lossless/
character-performer/kids/rig_demo/out/
character-performer/kids/cc_*.out
character-performer/kids/cc_*.err
character-performer/kids/turn4_cc_*.out
character-performer/kids/turn4_cc_*.err

# Video files are local artifacts; never commit them.
*.3[gG][pP]
*.[aA][vV][iI]
*.[fF][lL][vV]
*.[mM]2[tT][sS]
*.[mM]4[pP]
*.[mM]4[vV]
*.[mM][kK][vV]
*.[mM][oO][vV]
*.[mM][pP]4
*.[mM][pP][eE][gG]
*.[mM][pP][gG]
*.[mM][tT][sS]
!remotion-composer/vitest.config.mts
*.[oO][gG][vV]
*.[wW][eE][bB][mM]
*.[wW][mM][vV]

# Agent/SQLite session state and temporary Remotion sandboxes
:memory:.ses
*.ses
remotion-composer/.tmp_*/
