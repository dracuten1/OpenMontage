{
  "s01": [
    {
      "text": "Tin nhanh ngày 18 tháng 10.",
      "start": 0.0,
      "end": 0.96
    },
    {
      "text": "Năm tin đáng chú ý nhất",
      "start": 1.46,
      "end": 2.18
    },
    {
      "text": "hôm nay: Việt Nam ký hiệp",
      "start": 2.18,
      "end": 3.28
    },
    {
      "text": "định thương mại tự do mới,",
      "start": 3.28,
      "end": 4.16
    },
    {
      "text": "giá xăng rẻ nhất khu vực,",
      "start": 4.48,
      "end": 5.48
    },
    {
      "text": "Quảng Ninh siết chỉ tiêu tăng trưởng,",
      "start": 5.78,
      "end": 6.84
    },
    {
      "text": "Ukraine tung đòn drone lớn nhất năm,",
      "start": 7.36,
      "end": 9.0
    },
    {
      "text": "và các ông lớn",
      "start": 9.44,
      "end": 10.0
    },
    {
      "text": "AI kêu gọi làm chậm AI.",
      "start": 10.0,
      "end": 11.14
    }
  ],
  "s02": [
    {
      "text": "Tin một, kinh tế.",
      "start": 0.0,
      "end": 1.18
    },
    {
      "text": "Sáng nay tại Hà Nội,",
      "start": 1.64,
      "end": 2.34
    },
    {
      "text": "Việt Nam chính thức ký hiệp",
      "start": 2.58,
      "end": 3.4
    },
    {
      "text": "định thương mại tự do VEFTA",
      "start": 3.4,
      "end": 4.48
    },
    {
      "text": "với khối EFTA, gồm Na Uy,",
      "start": 4.48,
      "end": 6.06
    },
    {
      "text": "Thụy Sĩ, Iceland và Liechtenstein,",
      "start": 6.22,
      "end": 7.86
    },
    {
      "text": "hứa hẹn cơ hội hợp tác",
      "start": 8.2,
      "end": 9.02
    },
    {
      "text": "và động lực tăng trưởng mới.",
      "start": 9.02,
      "end": 9.96
    }
  ],
  "s03": [
    {
      "text": "Tin hai, kinh tế.",
      "start": 0.0,
      "end": 0.74
    },
    {
      "text": "Thủ tướng Lê Minh Hưng",
      "start": 1.1,
      "end": 1.72
    },
    {
      "text": "khẳng định giá xăng dầu Việt",
      "start": 1.72,
      "end": 2.78
    },
    {
      "text": "Nam đang thấp nhất khu vực,",
      "start": 2.78,
      "end": 3.94
    },
    {
      "text": "nhờ biện pháp bình ổn kịp thời,",
      "start": 4.14,
      "end": 5.16
    },
    {
      "text": "dù giá thế giới tăng mạnh.",
      "start": 5.54,
      "end": 6.32
    }
  ],
  "s04": [
    {
      "text": "Tin ba, chính trị.",
      "start": 0.0,
      "end": 0.76
    },
    {
      "text": "Bí thư Quảng Ninh Quản Minh Cường",
      "start": 1.06,
      "end": 2.12
    },
    {
      "text": "siết quyết liệt chỉ tiêu tăng trưởng,",
      "start": 2.12,
      "end": 3.4
    },
    {
      "text": "nêu rõ sẽ cách chức,",
      "start": 3.5,
      "end": 4.18
    },
    {
      "text": "kể cả bí thư, chủ tịch,",
      "start": 4.52,
      "end": 5.54
    },
    {
      "text": "nếu tăng trưởng dưới 10 phần trăm.",
      "start": 5.98,
      "end": 7.12
    }
  ],
  "s05": [
    {
      "text": "Tin bốn, thế giới.",
      "start": 0.0,
      "end": 0.64
    },
    {
      "text": "Ukraine tung đòn drone lớn nhất",
      "start": 1.24,
      "end": 2.64
    },
    {
      "text": "trong năm vào Nga, máy bay",
      "start": 2.64,
      "end": 3.82
    },
    {
      "text": "không người lái đánh cả St.",
      "start": 3.82,
      "end": 4.78
    },
    {
      "text": "Petersburg. Zelensky cáo buộc Nga tiếp",
      "start": 4.78,
      "end": 7.12
    },
    {
      "text": "tục phá lệnh ngừng bắn năng lượng.",
      "start": 7.12,
      "end": 8.18
    }
  ],
  "s06": [
    {
      "text": "Tin năm, công nghệ. Ba ông",
      "start": 0.0,
      "end": 1.36
    },
    {
      "text": "chủ AI là Altman của OpenAI,",
      "start": 1.36,
      "end": 3.18
    },
    {
      "text": "Musk của xAI và Amodei của Anthropic",
      "start": 3.22,
      "end": 4.96
    },
    {
      "text": "đồng loạt kêu gọi làm chậm AI,",
      "start": 4.96,
      "end": 6.58
    },
    {
      "text": "cảnh báo rủi ro nghiêm trọng, trong",
      "start": 7.0,
      "end": 8.38
    },
    {
      "text": "lúc cổ phiếu công nghệ trượt dốc.",
      "start": 8.38,
      "end": 9.4
    }
  ],
  "s07": [
    {
      "text": "Trên đây là năm tin đáng",
      "start": 0.0,
      "end": 0.92
    },
    {
      "text": "chú ý ngày 18 tháng 10.",
      "start": 0.92,
      "end": 1.96
    },
    {
      "text": "Theo dõi để không",
      "start": 2.42,
      "end": 2.92
    },
    {
      "text": "bỏ lỡ tin ngày mai.",
      "start": 2.92,
      "end": 3.72
    }
  ]
}
