{
  "s01": [
    {
      "chunk_text": "Cách Điện tổng thống Pháp 200m, đám đông đã dựng barricade.",
      "anchor_start_word": 0,
      "anchor_end_word": 10,
      "start": 0.0,
      "end": 2.42
    },
    {
      "chunk_text": "Đây là chuyện đã xảy ra.",
      "anchor_start_word": 11,
      "anchor_end_word": 16,
      "start": 2.74,
      "end": 3.66
    },
    {
      "chunk_text": "Đêm 17/10, ở Paris.",
      "anchor_start_word": 17,
      "anchor_end_word": 20,
      "start": 3.94,
      "end": 5.18
    }
  ],
  "s02": [
    {
      "chunk_text": "Từ tháng 9, học sinh xuống đường vì thiếu giáo viên,",
      "anchor_start_word": 0,
      "anchor_end_word": 10,
      "start": 0.0,
      "end": 2.2
    },
    {
      "chunk_text": "cắt vị trí trong ngân sách 2027, và đòi bỏ nền tảng tuyển sinh Parcoursup.",
      "anchor_start_word": 11,
      "anchor_end_word": 25,
      "start": 2.42,
      "end": 6.54
    }
  ],
  "s03": [
    {
      "chunk_text": "Người lao động, áo vàng cũng nhập cuộc.",
      "anchor_start_word": 0,
      "anchor_end_word": 7,
      "start": 0.0,
      "end": 1.46
    },
    {
      "chunk_text": "Ngày 16/10, trang đảng bị hack.",
      "anchor_start_word": 8,
      "anchor_end_word": 13,
      "start": 1.7,
      "end": 3.2
    },
    {
      "chunk_text": "Lời kêu gọi trên TikTok của tài khoản V2 kèm bản đồ điểm tập hợp và barricade.",
      "anchor_start_word": 14,
      "anchor_end_word": 30,
      "start": 3.54,
      "end": 6.76
    }
  ],
  "s04": [
    {
      "chunk_text": "Thứ Bảy 17/10, cả nước có 550.000 người tuần hành theo Bộ Nội vụ,",
      "anchor_start_word": 0,
      "anchor_end_word": 13,
      "start": 0.0,
      "end": 3.4
    },
    {
      "chunk_text": "trong 110 cuộc biểu tình, riêng Paris là 110.000.",
      "anchor_start_word": 14,
      "anchor_end_word": 22,
      "start": 3.74,
      "end": 6.52
    },
    {
      "chunk_text": "Ban tổ chức nói con số lên tới 800.000.",
      "anchor_start_word": 23,
      "anchor_end_word": 31,
      "start": 6.84,
      "end": 8.66
    }
  ],
  "s05": [
    {
      "chunk_text": "Tại Paris, đám đông tiến tới cách Điện Élysée 200 mét,",
      "anchor_start_word": 0,
      "anchor_end_word": 10,
      "start": 0.0,
      "end": 2.3
    },
    {
      "chunk_text": "dựng barricade ngay trên đại lộ Champs-Élysées.",
      "anchor_start_word": 11,
      "anchor_end_word": 17,
      "start": 2.3,
      "end": 4.4
    },
    {
      "chunk_text": "Khi đoàn tuần hành tan, hàng chục cửa hàng bị đập phá và cướp.",
      "anchor_start_word": 18,
      "anchor_end_word": 31,
      "start": 4.4,
      "end": 7.34
    }
  ],
  "s06": [
    {
      "chunk_text": "Sau Paris, Limoges mất toà thị chính khánh thành năm 1883 — nó bị phóng hỏa,",
      "anchor_start_word": 0,
      "anchor_end_word": 14,
      "start": 0.0,
      "end": 3.54
    },
    {
      "chunk_text": "mái vòm và tháp chuông sụp: chính quyền gọi là thảm họa di sản.",
      "anchor_start_word": 15,
      "anchor_end_word": 28,
      "start": 3.76,
      "end": 6.42
    },
    {
      "chunk_text": "Lyon ghi nhận 200–300 cửa hàng bị đập phá.",
      "anchor_start_word": 29,
      "anchor_end_word": 37,
      "start": 6.82,
      "end": 8.96
    },
    {
      "chunk_text": "Marseille chứng kiến đám đông xông vào toà thị chính.",
      "anchor_start_word": 38,
      "anchor_end_word": 47,
      "start": 9.24,
      "end": 11.18
    }
  ],
  "s07": [
    {
      "chunk_text": "Đêm đó, 1.200 người bị bắt, riêng vùng Paris 855.",
      "anchor_start_word": 0,
      "anchor_end_word": 9,
      "start": 0.0,
      "end": 2.98
    },
    {
      "chunk_text": "Sau các ngày truy quét, tổng cộng lên tới gần 2.400, theo tổng kê của giới chức.",
      "anchor_start_word": 10,
      "anchor_end_word": 26,
      "start": 2.98,
      "end": 7.28
    },
    {
      "chunk_text": "997 cảnh sát bị thương.",
      "anchor_start_word": 27,
      "anchor_end_word": 31,
      "start": 7.68,
      "end": 9.04
    },
    {
      "chunk_text": "Và khoảng 3.000 cửa hàng bị cướp, đập phá.",
      "anchor_start_word": 32,
      "anchor_end_word": 40,
      "start": 9.04,
      "end": 11.22
    }
  ],
  "s08": [
    {
      "chunk_text": "Ngành bảo hiểm ước tính thiệt hại đêm 17/10 cỡ 1 tỷ euro — so với 795 triệu euro",
      "anchor_start_word": 0,
      "anchor_end_word": 17,
      "start": 0.0,
      "end": 4.96
    },
    {
      "chunk_text": "của bạo loạn 2023, và 256 triệu euro của áo vàng 2018–2019.",
      "anchor_start_word": 18,
      "anchor_end_word": 29,
      "start": 4.96,
      "end": 11.5
    },
    {
      "chunk_text": "Đợt đắt nhất lịch sử hiện đại của Pháp.",
      "anchor_start_word": 30,
      "anchor_end_word": 38,
      "start": 10.98,
      "end": 12.62
    }
  ],
  "s09": [
    {
      "chunk_text": "Tối hôm sau, Tổng thống Macron lên truyền hình trong cơn giận,",
      "anchor_start_word": 0,
      "anchor_end_word": 11,
      "start": 0.0,
      "end": 2.56
    },
    {
      "chunk_text": "hứa không khoan nhượng với người đập phá.",
      "anchor_start_word": 12,
      "anchor_end_word": 19,
      "start": 2.82,
      "end": 4.14
    },
    {
      "chunk_text": "Bộ trưởng Nội vụ Nuñez nộp đơn từ chức — nhưng bị từ chối.",
      "anchor_start_word": 20,
      "anchor_end_word": 32,
      "start": 4.7,
      "end": 7.1
    },
    {
      "chunk_text": "Đến 22/10, chính phủ cấm các cuộc biểu tình bất hợp pháp.",
      "anchor_start_word": 33,
      "anchor_end_word": 44,
      "start": 7.56,
      "end": 10.38
    }
  ],
  "s10": [
    {
      "chunk_text": "Từ tháng 9 đến 22/10, biểu tình leo thang rồi bị cấm.",
      "anchor_start_word": 0,
      "anchor_end_word": 11,
      "start": 0.0,
      "end": 3.14
    },
    {
      "chunk_text": "Hôm nay 23/10, hội đồng quốc phòng họp trước tổng huy động thứ Bảy 24/10.",
      "anchor_start_word": 12,
      "anchor_end_word": 26,
      "start": 3.46,
      "end": 7.0
    },
    {
      "chunk_text": "Lyon, Marseille, Nice đã cấm sẵn.",
      "anchor_start_word": 27,
      "anchor_end_word": 32,
      "start": 7.36,
      "end": 9.02
    }
  ],
  "s11": [
    {
      "chunk_text": "Ở Nice, du học sinh Trịnh Minh Hằng kể trường mình nằm trong khu vực biểu tình,",
      "anchor_start_word": 0,
      "anchor_end_word": 16,
      "start": 0.0,
      "end": 3.06
    },
    {
      "chunk_text": "sinh hoạt đảo lộn.",
      "anchor_start_word": 17,
      "anchor_end_word": 20,
      "start": 3.06,
      "end": 3.84
    },
    {
      "chunk_text": "Người Việt lâu năm không ngạc nhiên;",
      "anchor_start_word": 21,
      "anchor_end_word": 27,
      "start": 4.28,
      "end": 5.3
    },
    {
      "chunk_text": "người mới đến bị sốc khi thấy cảnh đốt phá.",
      "anchor_start_word": 28,
      "anchor_end_word": 37,
      "start": 5.66,
      "end": 7.22
    }
  ],
  "s12": [
    {
      "chunk_text": "Nhận định: sáu tháng trước bầu cử 2027, sống đắt thành khủng hoảng chính trị.",
      "anchor_start_word": 0,
      "anchor_end_word": 14,
      "start": 0.0,
      "end": 3.62
    },
    {
      "chunk_text": "Với người đi làm, đây là lời nhắc cần đệm chi phí cá nhân.",
      "anchor_start_word": 15,
      "anchor_end_word": 28,
      "start": 3.76,
      "end": 6.48
    }
  ],
  "s13": [
    {
      "chunk_text": "Theo dõi, để xem thứ Bảy 24/10 chuyện gì sẽ xảy ra.",
      "anchor_start_word": 0,
      "anchor_end_word": 11,
      "start": 0.0,
      "end": 2.8
    }
  ]
}
